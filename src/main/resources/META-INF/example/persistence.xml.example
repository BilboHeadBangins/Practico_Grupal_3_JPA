<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
  
  <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    
    <class>com.mycompany.practico_grupal_2_jpa.entities.Cliente</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.CondicionIva</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.Contacto</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.Domicilio</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.FacturaVenta</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.FacturaVentaDetalle</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.ListaPrecio</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.ListaPrecioArticulo</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.Marca</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.PuntoVenta</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.Rubro</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.TipoMoneda</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.Usuario</class>
    <class>com.mycompany.practico_grupal_2_jpa.entities.Articulo</class>
    
    <!-- datos de conexión de referencia. Los reales no están expuestos por motivos de seguridad -->
    <properties>
      <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://direccion_ip:5432/facturacion"/>
      <property name="javax.persistence.jdbc.user" value="postgres"/>
      <property name="javax.persistence.jdbc.password" value="contraseña"/>

      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
    </properties>
  </persistence-unit>
</persistence>
